ArmorSetBonus: {
	/* SquireTier3:
		'''
		Increases your max number of sentries by 1
		Greatly enhances Ballista effectiveness
		''' */
	/* ApprenticeTier3:
		'''
		Increases your max number of sentries by 1
		Greatly enhances Flameburst effectiveness
		''' */
	/* HuntressTier3:
		'''
		Increases your max number of sentries by 1
		Greatly enhances Explosive Traps effectiveness
		''' */
	/* MonkTier3:
		'''
		Increases your max number of sentries by 1
		Greatly enhances Lightning Aura effectiveness
		''' */
	/* SquireTier2:
		'''
		Increases your max number of sentries by 1
		Ballista pierces more targets and panics when you take damage
		''' */
	/* ApprenticeTier2:
		'''
		Increases your max number of sentries by 1
		Flameburst field of view and range are dramatically increased
		''' */
	/* HuntressTier2:
		'''
		Increases your max number of sentries by 1
		Explosive Traps recharge faster and oil enemies
		Set oiled enemies on fire for extra damage
		''' */
	/* MonkTier2:
		'''
		Increases your max number of sentries by 1
		Lightning Aura can now crit and strikes faster
		''' */
	MetalTier1: 2 defense
	MetalTier2: 3 defense
	CobaltRanged: 20% chance to save ammo
	MythrilCaster: 17% reduced mana costs
	MythrilMelee: 10% increased melee critical strike chance
	MythrilRanged: 20% chance to save ammo
	AdamantiteCaster: 19% reduced mana costs
	AdamantiteMelee: 20% increased melee and movement speed
	AdamantiteRanged: 25% chance to save ammo
	TitaniumCaster: 19% reduced mana costs
	TitaniumMelee: 18% increased melee and movement speed
	TitaniumRanged: 25% chance to save ammo
	ShadowScale: Increased movement speed and acceleration
	Wood: 1 defense
	Crimson: Greatly increased life regen
	/* Frost:
		'''
		Melee and ranged attacks cause frostburn
		Increases melee and ranged damage by 10%
		''' */
	/* Tiki:
		'''
		Increases your max number of minions by 1
		Increases whip range by 20%
		''' */
	Palladium: Greatly increases life regeneration after striking an enemy
	Orichalcum: Flower petals will fall on your target for extra damage
	Titanium: Attacking generates a defensive barrier of titanium shards
	Hallowed: Become immune after striking an enemy
	Chlorophyte: Summons a powerful leaf crystal to shoot at nearby enemies
	/* ChlorophyteMelee:
		'''
		Summons a powerful leaf crystal to shoot at nearby enemies
		Reduces damage taken by 5%
		''' */
	Wizard: 10% increased magic critical strike chance
	/* Turtle:
		'''
		Attackers also take double damage
		Reduces damage taken by 15%
		''' */
	Meteor: Space Gun costs 0 mana
	/* SpectreHealing:
		'''
		Reduces Magic damage by 40% and converts it to healing force
		Magic damage done to enemies heals the player with lowest health
		''' */
	/* Shroomite:
		'''
		Not moving puts you in stealth,
		increasing ranged ability and reducing chance for enemies to target you
		''' */
	Platinum: 4 defense
	Pumpkin: 10% increased damage
	Spooky: Increases summon damage by 25%
	SpectreDamage: Magic damage done will hurt extra nearby enemies
	MagicHat: Increases maximum mana by 60
	BeetleDefense: Beetles protect you from damage
	BeetleDamage: Beetles increase your melee damage and speed
	Bee: Increases summon damage by 10%
	Spider: Increases summon damage by 12%
	/* Solar:
		'''
		Reduces damage taken by 12%
		Solar shields charge over time to protect you & let you dash
		A charge is used to damage enemies you touch
		Consumed charges explode & damage enemies
		''' */
	/* Vortex:
		'''
		Double tap {ToggleArmorSetBonusKey} to toggle stealth,
		increasing ranged ability and reducing chance for enemies to target you but slowing movement speed
		''' */
	/* Nebula:
		'''
		Magic damage has a chance to spawn buff boosters
		Pick boosters up to get stacking buffs
		''' */
	Stardust: A stardust guardian will protect you from nearby enemies
	Forbidden: Double tap {ToggleArmorSetBonusKey} to call an ancient storm to the cursor location
	Jungle: 16% reduced mana costs
	/* Molten:
		'''
		10% extra melee damage
		Grants immunity to fire blocks
		Cannot be set on fire
		''' */
	Snow: Cannot be frozen or chilled
	Mining: 10% increased mining speed
	CobaltCaster: 14% reduced mana costs
	CobaltMelee: 15% increased melee speed
	Bone: 10% increased ranged critical strike chance
	Ninja: 20% increased movement speed
	Fossil: 20% chance to save ammo
	/* HallowedSummoner:
		'''
		Become immune after striking an enemy
		Increases your max number of minions by 2
		''' */
	/* CrystalNinja:
		'''
		Allows the ability to dash
		10% increased damage and critical strike chance
		''' */
	Cactus: Attackers take damage from the cactus spines
	Gladiator: Grants immunity to knockback
	/* ObsidianOutlaw:
		'''
		Increases whip range by 30% and speed by 15%
		Increases summon damage by 15%
		''' */
	Angler: Decreased enemy spawn rate
	AshWood: Reduces damage from touching lava
	/* ChlorophyteSummon:
		'''
		Summons a powerful leaf crystal to shoot at nearby enemies
		Increases your max number of minions by 2
		''' */
}
